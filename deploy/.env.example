# Deploy configuration for scripts/deploy.sh
# Copy to deploy/.env and fill in real values.

# GHCR image prefix (from .github/workflows/cd.yml), e.g. ghcr.io/yourname/stock-eye
IMAGE_PREFIX=ghcr.io/yourname/stock-eye

# Auth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me

# Postgres password for the deployed database
POSTGRES_PASSWORD=change-me
