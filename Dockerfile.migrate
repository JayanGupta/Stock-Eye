# Lightweight container that runs DB migrations and seeds demo data.
# Runs once on first boot (migrate deploy is idempotent; seed is a no-op if
# demo user already exists), then exits so web can start.
FROM node:22-alpine
RUN corepack enable

WORKDIR /app

# ── Install workspace dependencies ────────────────────────────────────
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile

# ── Copy Prisma config + schema + migrations ──────────────────────────
COPY web/prisma.config.ts ./web/prisma.config.ts
COPY web/prisma        ./web/prisma

# ── Copy source files needed for seed ────────────────────────────────
COPY web/tsconfig.json          ./web/tsconfig.json
COPY web/src/lib/db.ts          ./web/src/lib/db.ts
COPY web/src/lib/seed.ts        ./web/src/lib/seed.ts
COPY web/src/data               ./web/src/data

# ── Generate Prisma client (no DATABASE_URL needed here) ──────────────
RUN pnpm --filter web db:generate

# ── Run migrations, then seed (DATABASE_URL must be set at runtime) ───
CMD ["sh", "-c", \
  "pnpm --filter web exec prisma migrate deploy && pnpm --filter web db:seed"]
