# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/stockeye"

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Required when behind a proxy (Vercel, tunnels, reverse proxy)
AUTH_TRUST_HOST="true"

# Optional: OAuth providers (add when enabling Google/GitHub sign-in)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
