# ── Required ──────────────────────────────────────────────────────────
# Generate a secure value with:
#   PowerShell: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   macOS/Linux: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-random-string

# ── Optional (defaults shown) ─────────────────────────────────────────
# Postgres password used by Docker Compose (keep default for local dev)
POSTGRES_PASSWORD=stockeye_dev
